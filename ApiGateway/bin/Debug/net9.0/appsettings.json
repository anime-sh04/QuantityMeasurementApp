{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Jwt": {
    "Key": "RANOEIgeoigheitu398yt984efuhvasdfgfdwertgrw234565123454qwertrsdfgdjsghj",
    "Issuer": "QuantityMeasurementApi",
    "Audience": "QuantityMeasurementClients"
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5000",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "conversion-compare": {
        "ClusterId": "conversion-cluster",
        "Match": { "Path": "/api/quantity/compare" }
      },
      "conversion-add": {
        "ClusterId": "conversion-cluster",
        "Match": { "Path": "/api/quantity/add" }
      },
      "conversion-subtract": {
        "ClusterId": "conversion-cluster",
        "Match": { "Path": "/api/quantity/subtract" }
      },
      "conversion-divide": {
        "ClusterId": "conversion-cluster",
        "Match": { "Path": "/api/quantity/divide" }
      },
      "conversion-convert": {
        "ClusterId": "conversion-cluster",
        "Match": { "Path": "/api/quantity/convert" }
      },
      "history-route": {
        "ClusterId": "history-cluster",
        "Match": {
          "Path": "/api/quantity/history/{**catch-all}"
        }
      },
      "stats-route": {
        "ClusterId": "history-cluster",
        "Match": { "Path": "/api/quantity/stats" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://auth-service:5001"
          }
        }
      },
      "conversion-cluster": {
        "Destinations": {
          "conversion-service": {
            "Address": "http://conversion-service:5002"
          }
        }
      },
      "history-cluster": {
        "Destinations": {
          "history-service": {
            "Address": "http://history-service:5003"
          }
        }
      }
    }
  }
}
